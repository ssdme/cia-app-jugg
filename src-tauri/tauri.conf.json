{
  "productName": "cia app",
  "version": "1.0.2",
  "identifier": "io.github.cia213.ciaapp",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["nsis"],
    "shortDescription": "cia app desktop shell.",
    "longDescription": "cia app desktop application shell and about interface.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "cia app",
        "displayLanguageSelector": false,
        "compression": "lzma"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIwREI5RTEwM0VEQTM2QzQKUldURU50bytFSjdiSURuejUrUjJ1N2JOMjJxS1pMYzBKN1JmN003YUhQaFU4MDNGT3dHcVVMVXYK",
      "endpoints": [
        "https://github.com/cia213/cia-app/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "cia app",
        "width": 960,
        "height": 580,
        "minWidth": 920,
        "minHeight": 540,
        "resizable": true,
        "decorations": false,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  }
}
